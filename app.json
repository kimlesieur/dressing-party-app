{
  "expo": {
    "name": "Dressing Party",
    "slug": "dressing-party",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47b78a2e-7655-4a54-a8ab-1d451a75553e"
      }
    },
    "owner": "kimlesieur",
    "android": {
      "package": "com.kimlesieur.dressingparty"
    }
  }
}
