rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Allow authenticated users to read and write all files in the /clothing/ path
    match /clothing/{allClothing=**} {
      allow read, write: if isAuthenticated();
    }

    // Allow authenticated users to read and write all files in the /avatar/ path
    match /avatar/{allAvatar=**} {
      allow read, write: if isAuthenticated();
    }

    // OPTIONAL: Deny all other access by default
    // If you don't have other specific rules, this is a good
    // fallback to ensure nothing else is publicly accessible.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
